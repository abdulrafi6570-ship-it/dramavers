{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/twixtor-archive run build",
  "outputDirectory": "artifacts/twixtor-archive/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quart-shallow-frog.abasthan.app/api/:path*"
    },
    {
      "source": "/r2proxy/:path*",
      "destination": "https://quart-shallow-frog.abasthan.app/r2proxy/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/"
  }
}
